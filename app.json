{
  "expo": {
    "name": "和諧食譜 Kindcipe",
    "slug": "kindcipe",
    "owner": "kindcipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2E4A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kindcipe.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "需要存取相片庫以上傳食譜截圖",
        "NSCameraUsageDescription": "需要存取相機以拍攝食譜截圖",
        "NSClipboardUsageDescription": "偵測剪貼板中的食譜連結"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C2E4A"
      },
      "package": "com.kindcipe.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@sentry/react-native",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "需要存取相片庫以上傳食譜截圖"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "kindcipe",
    "platforms": [
      "ios",
      "android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59ee279e-514a-4fb6-b98c-f04c84b969c0"
      }
    }
  }
}
