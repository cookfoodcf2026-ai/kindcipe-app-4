---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, ctaUrl, localizePath } from "../../i18n/ui";

const lang = "zh-HK" as const;
const t = useTranslations(lang);
const cta = ctaUrl("recipes");

export async function getStaticPaths() {
  const items = await getCollection("recipes", ({ data }) => data.lang === "zh-HK");
  return items.map((recipe) => ({ params: { slug: recipe.data.slug }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  name: recipe.data.title,
  description: recipe.data.description,
  recipeCuisine: recipe.data.cuisine,
  totalTime: `PT${recipe.data.cookTime}M`,
  recipeIngredient: recipe.data.ingredients,
  recipeInstructions: recipe.data.steps.map((s: string) => ({ "@type": "HowToStep", text: s })),
};
---

<Layout lang={lang} title={`${recipe.data.title} — ${t("site.name")}`} description={recipe.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="recipe container">
    <p class="meta">
      {recipe.data.cookTime} {t("recipes.minutes")} · {recipe.data.difficulty} · {recipe.data.cuisine}
    </p>
    <h1>{recipe.data.title}</h1>
    <p class="desc">{recipe.data.description}</p>

    <h2>{t("recipes.ingredients")}</h2>
    <ul>{recipe.data.ingredients.map((i: string) => <li>{i}</li>)}</ul>

    <h2>{t("recipes.steps")}</h2>
    <ol>{recipe.data.steps.map((s: string) => <li>{s}</li>)}</ol>

    <div class="recipe-cta">
      <a class="btn btn-primary" href={cta}>{t("recipes.cta")}</a>
    </div>

    <p class="back"><a href={localizePath("/recipes/", lang)}>← {t("recipes.back")}</a></p>
  </article>
</Layout>

<style>
  .recipe {
    max-width: 720px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .recipe .meta {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .recipe h1 {
    color: var(--color-primary);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    margin-bottom: 1rem;
  }
  .recipe .desc {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }
  .recipe h2 {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin: 1.75rem 0 0.75rem;
  }
  .recipe ul,
  .recipe ol {
    margin: 0 0 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .recipe-cta {
    margin: 2.5rem 0 1.5rem;
  }
  .back a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }
</style>
