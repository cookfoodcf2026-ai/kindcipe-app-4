---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, ctaUrl, localizePath } from "../../i18n/ui";

const lang = "zh-HK" as const;
const t = useTranslations(lang);
const cta = ctaUrl("blog");

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "zh-HK");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout lang={lang} title={`${post.data.title} — ${t("site.name")}`} description={post.data.description}>
  <article class="post container">
    <p class="meta">{post.data.date}</p>
    <h1>{post.data.title}</h1>
    <div class="body">
      <Content />
    </div>

    <div class="post-cta">
      <a class="btn btn-primary" href={cta}>{t("blog.cta")}</a>
    </div>

    <p class="back"><a href={localizePath("/blog/", lang)}>← {t("blog.back")}</a></p>
  </article>
</Layout>

<style>
  .post {
    max-width: 720px;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .post .meta {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
  }
  .post h1 {
    color: var(--color-primary);
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }
  .body :global(h2) {
    color: var(--color-primary);
    font-size: 1.25rem;
    margin: 1.75rem 0 0.75rem;
  }
  .body :global(p) {
    margin-bottom: 1rem;
  }
  .body :global(ul) {
    margin: 0 0 1rem 1.25rem;
  }
  .body :global(li) {
    margin-bottom: 0.4rem;
  }
  .post-cta {
    margin: 2.5rem 0 1.5rem;
  }
  .back a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }
</style>
