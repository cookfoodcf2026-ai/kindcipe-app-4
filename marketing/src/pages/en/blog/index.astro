---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { useTranslations, localizePath } from "../../../i18n/ui";

const lang = "en" as const;
const t = useTranslations(lang);

const posts = (await getCollection("blog", ({ data }) => data.lang === "en")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout lang={lang} title={`${t("blog.title")} — ${t("site.name")}`} description={t("blog.subtitle")}>
  <section class="page-hero">
    <h1>{t("blog.title")}</h1>
    <p class="sub">{t("blog.subtitle")}</p>
  </section>

  <section class="section container">
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-card">
            <a href={localizePath(`/blog/${post.data.slug}/`, lang)}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="read-more">{t("blog.readMore")} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .post-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }
  .post-card {
    background: var(--color-surface);
    border: 1px solid #eee;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(1, 62, 119, 0.06);
    transition: transform 0.15s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
  }
  .post-card a {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
  }
  .post-card h2 {
    color: var(--color-primary);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .post-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .read-more {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
