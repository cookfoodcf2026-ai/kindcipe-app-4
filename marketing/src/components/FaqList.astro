---
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang: Lang;
  prefix: "faq" | "support";
  count: number;
}

const { lang, prefix, count } = Astro.props;
const t = useTranslations(lang);

const items = Array.from({ length: count }, (_, i) => {
  const n = i + 1;
  return {
    q: t(`${prefix}.q${n}` as Parameters<typeof t>[0]),
    a: t(`${prefix}.a${n}` as Parameters<typeof t>[0]),
  };
});
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>
