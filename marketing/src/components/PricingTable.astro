---
import { useTranslations, ctaUrl, type Lang } from "../i18n/ui";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cta = ctaUrl("pricing");

const free = [t("pricing.free.f1"), t("pricing.free.f2"), t("pricing.free.f3"), t("pricing.free.f4")];
const paid = [
  t("pricing.paid.f1"),
  t("pricing.paid.f2"),
  t("pricing.paid.f3"),
  t("pricing.paid.f4"),
  t("pricing.paid.f5"),
  t("pricing.paid.f6"),
];
---

<div class="pricing">
  <div class="plan">
    <h3>{t("pricing.free.name")}</h3>
    <div class="price">{t("pricing.free.price")} <span class="period">{t("pricing.free.period")}</span></div>
    <ul>{free.map((f) => <li>{f}</li>)}</ul>
    <a class="btn btn-secondary" href={cta}>{t("pricing.cta")}</a>
  </div>

  <div class="plan plan-featured">
    <span class="badge">{t("pricing.paid.badge")}</span>
    <h3>{t("pricing.paid.name")}</h3>
    <div class="price">{t("pricing.paid.price")} <span class="period">{t("pricing.paid.period")}</span></div>
    <p class="yearly">{t("pricing.paid.yearly")}</p>
    <ul>{paid.map((f) => <li>{f}</li>)}</ul>
    <a class="btn btn-primary" href={cta}>{t("pricing.cta")}</a>
  </div>
</div>
