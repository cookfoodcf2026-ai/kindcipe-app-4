---
import { getCollection } from "astro:content";
import { localizePath, useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = (await getCollection("recipes", ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.cookTime - b.data.cookTime,
);
---

<ul class="recipe-grid">
  {
    items.map((r) => (
      <li class="recipe-card">
        <a href={localizePath(`/recipes/${r.data.slug}/`, lang)}>
          <h3>{r.data.title}</h3>
          <p>{r.data.description}</p>
          <span class="recipe-meta">
            {r.data.cookTime} {t("recipes.minutes")} · {r.data.difficulty}
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .recipe-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }
  .recipe-card {
    background: var(--color-surface);
    border: 1px solid #eee;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(1, 62, 119, 0.06);
    transition: transform 0.15s ease;
  }
  .recipe-card:hover {
    transform: translateY(-2px);
  }
  .recipe-card a {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
  }
  .recipe-card h3 {
    color: var(--color-primary);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .recipe-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }
  .recipe-meta {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.85rem;
  }
</style>
