---
import { useTranslations, type Lang } from "../i18n/ui";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons = ["📥", "🗓️", "🛒", "🧑‍🍳", "👨‍👩‍👧‍👦", "🍳"];
const items = icons.map((icon, i) => {
  const n = i + 1;
  return {
    icon,
    title: t(`features.f${n}.title` as Parameters<typeof t>[0]),
    desc: t(`features.f${n}.desc` as Parameters<typeof t>[0]),
  };
});
---

<ul class="features">
  {
    items.map((item) => (
      <li class="feature">
        <span class="icon" aria-hidden="true">{item.icon}</span>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </li>
    ))
  }
</ul>
