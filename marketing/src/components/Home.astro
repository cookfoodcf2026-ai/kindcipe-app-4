---
import { useTranslations, ctaUrl, localizePath, type Lang } from "../i18n/ui";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const primary = ctaUrl("home");
---

<section class="hero container">
  <h1>{t("home.title")}</h1>
  <p class="sub">{t("home.description")}</p>
  <div class="actions">
    <a class="btn btn-primary" href={primary}>{t("home.ctaPrimary")}</a>
    <a class="btn btn-secondary" href={localizePath("/features/", lang)}>{t("home.ctaSecondary")}</a>
  </div>
  <p class="note">{t("home.note")}</p>
</section>

<style>
  .hero {
    padding: 5rem 1.25rem 4rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-primary);
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }

  .sub {
    max-width: 620px;
    margin: 0 auto 2rem;
    color: var(--color-text-secondary);
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .note {
    margin-top: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
</style>
