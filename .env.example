# Kindcipe App Environment Configuration
# Copy this file to .env and modify as needed

# Backend API URL
# Production (default): https://kindcipe-backend-production.up.railway.app
# Development: Your ngrok tunnel URL (e.g., https://xxx.ngrok-free.dev)
# Local: http://localhost:3000 or http://YOUR_IP:3000 for physical device
#
# ⚠️ After modifying .env, you must restart the Expo dev server:
#    npx expo start --clear

EXPO_PUBLIC_API_URL=https://kindcipe-backend-production.up.railway.app

# Web App URL (for recipe sharing feature)
# Set this after deploying the static website (kindcipe-site)
EXPO_PUBLIC_WEBAPP_URL=https://kindcipe.com
