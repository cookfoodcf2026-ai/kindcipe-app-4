# Kindcipe app — public client configuration.
#
# NOTE: every value here is EXPO_PUBLIC_* and therefore embedded in the shipped
# app/web bundle by design (safe to be public). Do NOT add secrets here — put
# private/dev-only values in .env.local (gitignored) instead.
#
# The backend keeps its own DASHSCOPE_API_KEY on Railway; the app never reads it.

# Backend API. Kept on the Railway host for now: the api.kindcipe.com custom
# domain is not live yet, so pointing here avoids breaking the web app. Switch
# to https://api.kindcipe.com (CNAME -> Railway) to make the session cookie
# first-party. Apple web sign-in already works regardless via the #token=
# fragment fallback.
EXPO_PUBLIC_API_URL=https://kindcipe-backend-production.up.railway.app

EXPO_PUBLIC_PRIVACY_URL=https://kindcipe.com/privacy/
EXPO_PUBLIC_STORE_URL=https://kindcipe.com
EXPO_PUBLIC_SUPPORT_URL=https://kindcipe.com/support/

# Web app (Expo Web) — recipe share links + Apple web OAuth return.
EXPO_PUBLIC_WEBAPP_URL=https://app.kindcipe.com
# Marketing site (Astro SEO pages). Official recipes share here (public, no login).
EXPO_PUBLIC_MARKETING_URL=https://kindcipe.com
EXPO_PUBLIC_ENABLE_APPLE_WEB=1

# PostHog analytics (leave empty to disable)
EXPO_PUBLIC_POSTHOG_KEY=phc_CQ7LWFNnTqdfD73DTKoE5R97dwspRvTUcwEjGkWXAAr9
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
