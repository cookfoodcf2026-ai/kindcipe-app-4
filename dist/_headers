# Kindcipe web app (Expo Router, static export) — Cloudflare Pages
# Build command: npm run build:web   (see package.json)
# Output directory: dist

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SPA fallback: serve index.html for client routes (deep links).
# Cloudflare Pages handles this automatically for a single-page app shell,
# but explicit 200 rewrite keeps Expo Router paths working.
