# Kindcipe web app (Expo Router, static export) — served by Cloudflare Worker `kindcipe-app`
# (wrangler.jsonc: assets=dist). Deploy: npm run build:web && npx wrangler deploy
# Output directory: dist

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  X-Robots-Tag: noindex, nofollow

/_expo/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# SPA fallback: serve index.html for client routes (deep links).
# Cloudflare Pages handles this automatically for a single-page app shell,
# but explicit 200 rewrite keeps Expo Router paths working.
